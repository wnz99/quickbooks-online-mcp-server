# QuickBooks OAuth Credentials
QUICKBOOKS_CLIENT_ID=your_client_id
QUICKBOOKS_CLIENT_SECRET=your_client_secret
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token
QUICKBOOKS_REALM_ID=your_realm_id
QUICKBOOKS_ENVIRONMENT=sandbox

# MCP Server Config
MCP_TRANSPORT=stdio
MCP_PORT=3000
MCP_LOG_LEVEL=info

# For public HTTP hosting, set a strong MCP_API_KEY and register the HTTPS callback with Intuit.
# MCP_API_KEY=replace_with_a_long_random_secret
# QUICKBOOKS_REDIRECT_URI=https://your-host.example/callback

# Set in the host process environment; must be absolute. Overrides package .env loading.
# QUICKBOOKS_TOKEN_STORE_PATH=/var/lib/qbo/tokens.env

# Optional tool restrictions (default: all categories enabled)
# QUICKBOOKS_DISABLE_WRITE=true
# QUICKBOOKS_DISABLE_UPDATE=true
# QUICKBOOKS_DISABLE_DELETE=true

# File boundaries
# QUICKBOOKS_ATTACHABLE_BASE_DIR=/absolute/upload/directory
# QUICKBOOKS_ATTACHABLE_URL_TIMEOUT_MS=60000
# QBO_PDF_OUTPUT_DIR=/absolute/pdf/output
# QBO_PDF_MAX_BYTES=52428800
